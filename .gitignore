# OS
.DS_Store
Thumbs.db

# ────────────────────────────────────────────────────────────
#  Secrets — explicit deny-list as a safety net
#  The canonical store for the Google Maps API credential is
#  Backend/src/main/resources/google-credentials.properties.
#  Replace it with google-credentials.properties.example
#  (a placeholder, no real key) when committing.
# ────────────────────────────────────────────────────────────
**/google-credentials.properties
**/application-local.properties
**/application-secret.properties
**/.env

# Allow the .example placeholder to be committed
!**/google-credentials.properties.example
!**/.env.example

# ────────────────────────────────────────────────────────────
#  Runtime artifacts (local only)
# ────────────────────────────────────────────────────────────
*.pid
*.log
*.bak
cookies.txt
